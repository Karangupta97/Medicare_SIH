# =============================================================================
# PowerSync (offline dashboard) — Frontend configuration
# =============================================================================
# The dashboard sidebar features (reports, prescriptions, notifications, shared
# reports, family vault, emergency folder, etc.) can run offline via PowerSync.
#
# IMPORTANT: PowerSync is a SERVICE, not just an npm package. To go live you must
# provision a PowerSync instance (PowerSync Cloud or self-hosted Docker) pointed
# at the app's MongoDB Atlas cluster, then set the URL below.
#
# GRACEFUL DEGRADATION: if VITE_POWERSYNC_URL is empty/unset, the app runs
# EXACTLY as before — every sidebar screen falls back to the existing axios
# stores. PowerSync only activates once this URL is provided. So it is safe to
# ship this integration before the instance exists.
# =============================================================================

# The PowerSync service instance URL (e.g. https://xxxxx.powersync.journeyapps.com)
# Leave blank to disable PowerSync and use the online-only axios fallback.
VITE_POWERSYNC_URL=

# The backend endpoint the client calls to mint a per-user PowerSync JWT.
# Defaults to `${VITE_API_URL}/api/powersync/token` if unset.
VITE_POWERSYNC_TOKEN_ENDPOINT=

# Optional: turn PowerSync on/off explicitly regardless of URL (dev toggle).
# "true" | "false". If unset, PowerSync is enabled iff VITE_POWERSYNC_URL is set.
VITE_POWERSYNC_ENABLED=
