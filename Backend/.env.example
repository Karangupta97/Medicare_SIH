# =============================================================================
# Medicare Backend — Environment Variables (single source of truth)
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# SECURITY: Secrets (keys, tokens, peppers) MUST come from a secrets manager /
# KMS in production, not a committed file. This example lists every variable the
# backend reads, with placeholder values. Keep it in sync with `.env`.
#
# Line endings: keep this file (and .env) as LF. CRLF (\r) has previously
# corrupted values like SANDBOX_BASE_URL — if you edit in an editor, set LF.
# =============================================================================

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Optional cluster mode (default single-process). "true" to enable.
CLUSTER_MODE=false
# Optional worker count when CLUSTER_MODE=true.
WEB_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas)
# ---------------------------------------------------------------------------
# The app derives four DBs (Patient/Doctor/Management/Feedback) from this base
# URI by swapping the db name. Prefer the SRV form. NOTE the trailing db slot:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Legacy alias still present in .env; keep equal to MONGODB_URI if used anywhere.
MONGO_URI=

# ---------------------------------------------------------------------------
# AWS S3 (report / profile file storage)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ---------------------------------------------------------------------------
# App auth (legacy email JWT + Aadhaar access token signing)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Email providers
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ---------------------------------------------------------------------------
# Client / CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed client origins (no trailing slash).
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Third-party APIs (address/pincode, AI, etc.)
# ---------------------------------------------------------------------------
GEOIQ_API_KEY=
ZYLA_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# ---------------------------------------------------------------------------
# Razorpay (payments / plan upgrades)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===========================================================================
# Aadhaar OKYC patient authentication
# ===========================================================================
# HMAC pepper for aadhaar_identity_hash. Server-only secret, KMS in prod.
#   Generate with: openssl rand -base64 48
AADHAAR_HMAC_PEPPER=
# Comma-separated previous pepper(s) kept during a rotation window (optional).
AADHAAR_HMAC_PEPPER_PREVIOUS=
# Bump on each pepper rotation.
AADHAAR_HMAC_PEPPER_VERSION=1

# Field-level PII encryption key (AES-256-GCM). MUST decode to EXACTLY 32 bytes.
#   Generate with: openssl rand -base64 32
AADHAAR_FIELD_ENC_KEY=
AADHAAR_FIELD_ENC_KEY_VERSION=1

# ---- Sandbox (sandbox.co.in) Aadhaar OKYC provider ----
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Leave blank to auto-mint from key+secret (recommended). Do NOT put a stray
# character here — an almost-empty value is treated as a real (bad) token.
SANDBOX_ACCESS_TOKEN=
# Sandbox API version header (defaults to 2.0 if unset).
SANDBOX_API_VERSION=2.0

# KYC provider selection: "sandbox" (default) | "digilocker" (future).
AADHAAR_KYC_PROVIDER=sandbox

# ---- Registration + token lifetimes ----
REGISTRATION_SESSION_TTL_SECONDS=600
AADHAAR_ACCESS_TOKEN_TTL=15m
AADHAAR_REFRESH_TOKEN_TTL_DAYS=30

# ---- CAPTCHA / bot-attestation (gates paid OKYC calls) ----
# "recaptcha" | "hcaptcha" | "disabled". In production it must NOT be disabled.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# ===========================================================================
# PowerSync (offline dashboard) — see powersync/README.md
# ===========================================================================
# The PowerSync SERVICE connects to MongoDB itself (change streams). These keys
# are for the backend token endpoint + write queue. Leave blank to keep the app
# in online-only mode (graceful fallback).
POWERSYNC_JWT_SECRET=
POWERSYNC_URL=
POWERSYNC_JWT_TTL_SECONDS=300
POWERSYNC_JWT_KID=medicare-powersync-hs256
# RS256 mode (optional; overrides HS256 shared secret if set):
# POWERSYNC_JWT_PRIVATE_KEY=
# POWERSYNC_JWT_PUBLIC_KEY=
